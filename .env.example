# Токен доступа к сообществу ВКонтакте (community token)
# Права токена: сообщения (messages), желательно управление сообществом (groups)
VK_TOKEN=vk1.a.YOUR_VK_COMMUNITY_TOKEN

# ID сообщества ВКонтакте (число, без минуса и без знака)
VK_GROUP_ID=123456789

# Ключ API сервиса ProxyAPI (создаётся в личном кабинете proxyapi.ru, раздел «Ключи API»)
PROXY_API_KEY=sk-YOUR_PROXYAPI_KEY

# Базовый адрес API (менять не нужно)
PROXY_API_BASE_URL=https://api.proxyapi.ru/openai/v1

# Модель для генерации ответов (например: gpt-4o-mini, gpt-4o)
PROXY_API_MODEL=gpt-4o-mini

# Максимальное количество токенов в одном ответе (ограничивает стоимость запроса)
PROXY_MAX_TOKENS=300

# Таймаут запроса к API в секундах
PROXY_TIMEOUT=60

# Сколько последних сообщений диалога запоминать для каждого пользователя
HISTORY_LIMIT=20